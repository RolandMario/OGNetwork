# Expo environment variables
# Expo SDK 49+ reads .env files natively (prefix must be EXPO_PUBLIC_)

# Optional: Override API base URL
# In development, defaults to http://localhost:5001 (iOS) / http://10.0.2.2:5001 (Android)
# In production (__DEV__=false), defaults to https://og-network-backend.vercel.app
#
# Set this ONLY when you need to override the automatic detection, e.g.:
#   - Physical device testing against local backend on your LAN: http://192.168.x.x:5001
#   - Pointing a dev build at the production backend
#
# EXPO_PUBLIC_API_URL=https://og-network-backend.vercel.app